# PORT: Puerto HTTP del servidor Express + Vite (por defecto 3000; Render lo asigna automáticamente)
PORT=3000

# NODE_ENV: Usar "production" en Render para servir dist/ desde Express
NODE_ENV=development

# APP_URL: URL pública de la aplicación desplegada (ej. https://tu-app.onrender.com)
APP_URL="http://localhost:3000"

# CORS_ORIGIN: Opcional si publicas el frontend aparte en GitHub Pages (ej. https://usuario.github.io)
CORS_ORIGIN=""

# SESSION_SECRET: Clave secreta para firmar tokens de sesión HMAC-SHA256 (cambiar en producción)
SESSION_SECRET="cambia-esta-clave-secreta-en-produccion"

# ADMIN_PASSCODE: Código opcional para acceso/arranque directo como Administrador
ADMIN_PASSCODE=

# PostgreSQL (Render / Neon / Local)
# Opción 1 (Recomendada en Render/Neon): URL completa de conexión
DATABASE_URL=""
# SQL_SSL: Opcional ("true" o "false"). Si se omite, se detecta automáticamente según el host.
SQL_SSL=""

# Opción 2 (Variables separadas para conexión local o manual)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="tu_password_postgres"
SQL_DB_NAME="almacenpro"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="tu_password_postgres"
